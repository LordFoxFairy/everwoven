# Application mode: demo | dev | prod. Independent of NODE_ENV.
APP_ENV=demo

# Exact public Web origin. No wildcard. Local default shown below.
APP_ORIGIN=http://127.0.0.1:3100

# Explicit supplier/model selection. Empty means no provider is silently chosen.
VIDEO_PROVIDER=
VIDEO_MODEL=

# MiniMax official: VIDEO_PROVIDER=minimax
# VIDEO_MODEL=minimax-h3 or minimax-h3-max
# V2 task bindings registered. Continuous playback adapter pending.
MINIMAX_API_KEY=

# Optional fal deployment: VIDEO_PROVIDER=fal, VIDEO_MODEL=h3-max-director
# Requires APP_ENV=dev, next dev, and explicitly choosing this supplier. Never NEXT_PUBLIC_.
FAL_KEY=
FAL_LOCAL_ENABLED=false

# Optional formal local draft storage. Initialize first; only pnpm local enables it.
# Keep outside source checkout. Ordinary dev/Docker stays in browser storage mode.
RUNTIME_DATA_DIR=
