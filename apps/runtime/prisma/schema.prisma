// Authoring clean baseline: no database foreign keys, no ORM relations, no triggers.
// Primary keys + reviewed TRUE business uniqueness only; see UNIQUE-KEY-REGISTER.md.
// Reference/lifecycle validation belongs to WriteGate; business UNIQUE is also enforced by SQL.
// IDs and timestamps are supplied by runtime IdFactory / Clock, not database defaults.
// Exact approved additive migration chain; no legacy runtime protocol compatibility.
// Execution profiles and quotes are immutable. Generation execution is durable; private media and settlement composition remain pending.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider     = "sqlite"
  relationMode = "prisma"
}

model LocalProfile {
  writeEpoch  Int       @default(0) @map("write_epoch")
  deletedAt   DateTime? @map("deleted_at")
  id          String    @id
  displayName String    @map("display_name")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  revision    Int       @default(1)

  @@map("local_profiles")
}

model CommandReceipt {
  id            String   @id
  ownerId       String   @map("owner_id")
  commandId     String   @map("command_id")
  commandType   String   @map("command_type")
  payloadHash   String   @map("payload_hash")
  response      Json
  schemaVersion Int      @default(1) @map("schema_version")
  createdAt     DateTime @map("created_at")

  @@unique([ownerId, commandId], map: "uq_command_receipts_owner_command")
  @@map("command_receipts")
}

model StoryDraft {
  deletedAt     DateTime? @map("deleted_at")
  id            String    @id
  ownerId       String    @map("owner_id")
  title         String
  settings      Json
  schemaVersion Int       @default(1) @map("schema_version")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  revision      Int       @default(1)

  @@index([ownerId, deletedAt, archivedAt, updatedAt, id], map: "ix_story_drafts_owner_list")
  @@map("story_drafts")
}

model StoryVersion {
  sealedAt       DateTime? @map("sealed_at")
  id             String    @id
  ownerId        String    @map("owner_id")
  storyDraftId   String    @map("story_draft_id")
  versionNo      Int       @map("version_no")
  sourceRevision Int       @map("source_revision")
  title          String
  settings       Json
  contentHash    String?   @map("content_hash")
  schemaVersion  Int       @default(1) @map("schema_version")
  createdAt      DateTime  @map("created_at")

  @@unique([storyDraftId, versionNo], map: "uq_story_versions_number")
  @@unique([storyDraftId, sourceRevision], map: "uq_story_versions_source")
  @@map("story_versions")
}

model Asset {
  id                String    @id
  ownerId           String    @map("owner_id")
  storageKey        String    @map("storage_key")
  sha256            String
  mimeType          String    @map("mime_type")
  byteSize          BigInt    @map("byte_size")
  originalName      String    @map("original_name")
  width             Int
  height            Int
  rightsDeclaration String    @map("rights_declaration")
  status            String    @default("ready")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  revision          Int       @default(1)

  @@unique([storageKey], map: "uq_assets_storage_key")
  @@index([ownerId, sha256], map: "ix_assets_owner_hash")
  @@map("assets")
}

model CharacterTemplate {
  scope              String    @default("library")
  sourceStoryDraftId  String?   @map("source_story_draft_id")
  deletedAt       DateTime? @map("deleted_at")
  id              String    @id
  ownerId         String    @map("owner_id")
  name            String
  settings        Json
  portraitAssetId String?   @map("portrait_asset_id")
  schemaVersion   Int       @default(1) @map("schema_version")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")
  revision        Int       @default(1)

  @@index([ownerId, scope, deletedAt, updatedAt, id], map: "ix_character_templates_scope_list")
  @@index([ownerId, sourceStoryDraftId], map: "ix_character_templates_story")
  @@index([ownerId, portraitAssetId], map: "ix_character_templates_portrait")
  @@map("character_templates")
}

model CharacterVersion {
  id                  String   @id
  ownerId             String   @map("owner_id")
  characterTemplateId String   @map("character_template_id")
  versionNo           Int      @map("version_no")
  sourceRevision      Int      @map("source_revision")
  name                String
  settings            Json
  portraitAssetId     String?  @map("portrait_asset_id")
  schemaVersion       Int      @default(1) @map("schema_version")
  createdAt           DateTime @map("created_at")

  @@unique([characterTemplateId, versionNo], map: "uq_character_versions_number")
  @@unique([characterTemplateId, sourceRevision], map: "uq_character_versions_source")
  @@index([ownerId, portraitAssetId], map: "ix_character_versions_portrait")
  @@map("character_versions")
}

model StoryDraftCast {
