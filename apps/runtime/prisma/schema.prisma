  @@unique([storyDraftId, slotKey], map: "uq_story_draft_cast_slot")
  @@index([ownerId, characterVersionId], map: "ix_story_draft_cast_character")
  @@map("story_draft_cast")
}

model StoryDraftAsset {
  id           String   @id
  ownerId      String   @map("owner_id")
