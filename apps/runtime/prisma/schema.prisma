  createdAt          DateTime @map("created_at")

  @@unique([storyVersionId, slotKey], map: "uq_story_version_cast_slot")
  @@index([ownerId, characterVersionId], map: "ix_story_version_cast_character")
  @@map("story_version_cast")
}

model StoryVersionAsset {
  id             String   @id
  ownerId        String   @map("owner_id")
  storyVersionId String   @map("story_version_id")
  assetId        String   @map("asset_id")
  slotKey        String   @map("slot_key")
  purpose        String
  createdAt      DateTime @map("created_at")

  @@unique([storyVersionId, slotKey], map: "uq_story_version_assets_slot")
  @@index([ownerId, assetId], map: "ix_story_version_assets_asset")
  @@map("story_version_assets")
}

model ProviderBindingVersion {
  id                String   @id
  ownerId           String   @map("owner_id")
  bindingKey        String   @map("binding_key")
  versionNo         Int      @map("version_no")
  providerId        String   @map("provider_id")
  modelId           String   @map("model_id")
  adapterVersion    String   @map("adapter_version")
  capabilityVersion String   @map("capability_version")
  mode              String
  credentialRef     String   @map("credential_ref")
  parameters        Json
  capabilities      Json
  schemaVersion     Int      @default(1) @map("schema_version")
  createdAt         DateTime @map("created_at")

  @@unique([ownerId, bindingKey, versionNo], map: "uq_provider_binding_versions_number")
  @@map("provider_binding_versions")
}

model Experience {
  budgetScopeId String? @map("budget_scope_id")
  budgetLimitMicros        BigInt    @map("budget_limit_micros")
  budgetCurrency           String    @map("budget_currency")
  deletedAt                DateTime? @map("deleted_at")
  rowRevision              Int       @default(1) @map("row_revision")
  id                       String    @id
  ownerId                  String    @map("owner_id")
  storyVersionId           String    @map("story_version_id")
  providerBindingVersionId String    @map("provider_binding_version_id")
  status                   String    @default("preparing")
  schedulingPaused         Boolean   @default(true) @map("scheduling_paused")
  dispatchEpoch            Int       @default(0) @map("dispatch_epoch")
  archivedAt               DateTime? @map("archived_at")
  createdAt                DateTime  @map("created_at")
  updatedAt                DateTime  @map("updated_at")
  revision                 Int       @default(1)

  @@index([ownerId, deletedAt, archivedAt, updatedAt, id], map: "ix_experiences_owner_list")
  @@index([ownerId, storyVersionId], map: "ix_experiences_story_version")
  @@index([ownerId, providerBindingVersionId], map: "ix_experiences_binding")
  @@map("experiences")
}

model InteractionEvent {
  id                 String   @id
  ownerId            String   @map("owner_id")
  experienceId       String   @map("experience_id")
  kind               String
  experienceRevision Int      @map("experience_revision")
  options            Json
  schemaVersion      Int      @default(1) @map("schema_version")
  createdAt          DateTime @map("created_at")

  @@unique([experienceId, experienceRevision], map: "uq_interaction_events_revision")
  @@map("interaction_events")
}

model ResponseDraft {
  id                 String   @id
  ownerId            String   @map("owner_id")
  experienceId       String   @map("experience_id")
  interactionEventId String   @map("interaction_event_id")
  text               String   @default("")
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")
  revision           Int      @default(1)

  @@unique([ownerId, interactionEventId], map: "uq_response_drafts_node")
  @@map("response_drafts")
}

// Operational intent, not user content. Terminal deletion/expiry is status-based.
// Asset is inserted ready only after verified publication; no FK/cross-owner dedup.
model AssetUpload {
  id                 String   @id
  ownerId            String   @map("owner_id")
  assetId            String   @map("asset_id")
  inputSha256        String   @map("input_sha256")
  inputByteSize      BigInt   @map("input_byte_size")
  originalName       String   @map("original_name")
  rightsDeclaration String   @map("rights_declaration")
  status             String
  outputSha256       String?  @map("output_sha256")
  outputByteSize     BigInt?  @map("output_byte_size")
  outputWidth        Int?     @map("output_width")
  outputHeight       Int?     @map("output_height")
  processingToken    String?  @map("processing_token")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")
  expiresAt          DateTime @map("expires_at")
  revision           Int      @default(1)

  @@index([status, leaseExpiresAt, id], map: "ix_asset_uploads_recovery")
  @@index([ownerId, createdAt, id], map: "ix_asset_uploads_owner")
  @@index([assetId], map: "ix_asset_uploads_asset")
  @@map("asset_uploads")
}

// Immutable bounded execution identity. No update/delete lifecycle: old turns retain their profile.
model ExecutionProfileVersion {
  id                        String   @id
  ownerId                   String   @map("owner_id")
  profileKey                String   @map("profile_key")
  versionNo                 Int      @map("version_no")
  plannerBindingVersionId   String   @map("planner_binding_version_id")
  videoBindingVersionId     String   @map("video_binding_version_id")
  validatorBindingVersionId String   @map("validator_binding_version_id")
  snapshot                  Json
  contentHash               String   @map("content_hash")
  schemaVersion             Int      @default(1) @map("schema_version")
  createdAt                 DateTime @map("created_at")

  @@unique([ownerId, profileKey, versionNo], map: "uq_execution_profiles_version")
  @@map("execution_profile_versions")
}


model GenerationQuote {
 id String @id
 ownerId String @map("owner_id")
 datasetId String @map("dataset_id")
 storeEpoch String @map("store_epoch")
 experienceId String @map("experience_id")
 experienceRevision Int @map("experience_revision")
 interactionEventId String @map("interaction_event_id")
 profileId String @map("profile_id")
 maxCostMicros BigInt @map("max_cost_micros")
 currency String
 snapshot Json
 contentHash String @map("content_hash")
 acceptedTurnId String? @map("accepted_turn_id")
 createdAt DateTime @map("created_at")
 expiresAt DateTime @map("expires_at")
 schemaVersion Int @default(1) @map("schema_version")
 @@index([ownerId, experienceId, createdAt, id], map:"ix_generation_quotes_experience")
 @@map("generation_quotes")
}
model BudgetScope {
 id String @id
 ownerId String @map("owner_id")
 limitMicros BigInt @map("limit_micros")
 currency String
 createdAt DateTime @map("created_at")
 @@map("budget_scopes")
}
model GenerationTurn {
 inputSavepointId String? @map("input_savepoint_id")
 parentTurnId String? @map("parent_turn_id")
 prepared Json?
 providerReference Json? @map("provider_reference")
 media Json?
 result Json?
 id String @id
 ownerId String @map("owner_id")
 experienceId String @map("experience_id")
 budgetScopeId String @map("budget_scope_id")
 quoteId String @unique(map:"uq_generation_turn_quote") @map("quote_id")
 interactionEventId String @map("interaction_event_id")
 status String
 errorCode String? @map("error_code")
 createdAt DateTime @map("created_at")
 updatedAt DateTime @map("updated_at")
 revision Int @default(1)
 @@index([ownerId, experienceId, createdAt, id], map:"ix_generation_turn_experience")
 @@index([parentTurnId], map:"ix_generation_turn_parent")
 @@map("generation_turns")
}
model BudgetReservation {
 id String @id
 ownerId String @map("owner_id")
 experienceId String @map("experience_id")
 budgetScopeId String @map("budget_scope_id")
 reservedMicros BigInt @map("reserved_micros")
 settledMicros BigInt @map("settled_micros")
 currency String
 status String
 createdAt DateTime @map("created_at")
 updatedAt DateTime @map("updated_at")
 revision Int @default(1)
 @@index([budgetScopeId, status], map:"ix_budget_reservation_scope")
 @@index([ownerId, experienceId], map:"ix_budget_reservation_experience")
 @@map("budget_reservations")
}
model RuntimeOutbox {
 id String @id
 ownerId String @map("owner_id")
 kind String
 status String
 availableAt DateTime @map("available_at")
 leaseUntil DateTime? @map("lease_until")
 leaseToken String? @map("lease_token")
 createdAt DateTime @map("created_at")
 updatedAt DateTime @map("updated_at")
 revision Int @default(1)
 @@index([status, availableAt, id], map:"ix_runtime_outbox_ready")
 @@map("runtime_outbox")
}

// Immutable response evidence. One response per paid text stage; never a zero-cost inference.
model TextUsageObservation {
 id String @id
 ownerId String @map("owner_id")
 datasetId String @map("dataset_id")
 storeEpoch String @map("store_epoch")
 turnId String @map("turn_id")
 quoteId String @map("quote_id")
 profileId String @map("profile_id")
 stage String
 bindingHash String @map("binding_hash")
 observation Json
 contentHash String @map("content_hash")
 schemaVersion Int @default(1) @map("schema_version")
 createdAt DateTime @map("created_at")
 @@unique([turnId, stage], map:"uq_text_usage_turn_stage")
 @@index([ownerId, createdAt, id], map:"ix_text_usage_owner")
 @@map("text_usage_observations")
}

// Mutable delivery-bound viewing progress. Multiple attempts per turn are legitimate.
model PlaybackSession {
 id String @id
 ownerId String @map("owner_id")
 datasetId String @map("dataset_id")
 storeEpoch String @map("store_epoch")
 experienceId String @map("experience_id")
 experienceRevision Int @map("experience_revision")
 turnId String @map("turn_id")
 mediaId String @map("media_id")
 mediaHash String @map("media_hash")
 durationMs Int @map("duration_ms")
 coveredMs Int @default(0) @map("covered_ms")
 status String @default("active")
 sequence Int @default(0)
 lastPositionMs Int @default(0) @map("last_position_ms")
 startedAt DateTime @map("started_at")
 updatedAt DateTime @map("updated_at")
 expiresAt DateTime @map("expires_at")
 revision Int @default(1)
 @@index([ownerId, turnId, status], map:"ix_playback_sessions_turn")
 @@map("playback_sessions")
}
model StateSnapshot {
 id String @id
 ownerId String @map("owner_id")
 datasetId String @map("dataset_id")
 state Json
 contentHash String @map("content_hash")
 schemaVersion Int @default(1) @map("schema_version")
 createdAt DateTime @map("created_at")
 @@map("state_snapshots")
}
model Savepoint {
 id String @id
 ownerId String @map("owner_id")
 datasetId String @map("dataset_id")
 experienceId String @map("experience_id")
 kind String
 parentSavepointId String? @map("parent_savepoint_id")
 sourceTurnId String? @unique(map:"uq_savepoint_played_turn") @map("source_turn_id")
 stateSnapshotId String @map("state_snapshot_id")
 interactionEventId String @map("interaction_event_id")
 playbackSessionId String? @map("playback_session_id")
 createdAt DateTime @map("created_at")
 schemaVersion Int @default(1) @map("schema_version")
 @@index([ownerId, experienceId, createdAt, id], map:"ix_savepoints_experience")
 @@index([parentSavepointId], map:"ix_savepoints_parent")
 @@index([stateSnapshotId], map:"ix_savepoints_snapshot")
 @@map("savepoints")
}

// One immutable origin per child route; id is the child Experience id.
model ExperienceFork {
 id String @id
 ownerId String @map("owner_id")
 datasetId String @map("dataset_id")
 rootExperienceId String @map("root_experience_id")
 sourceExperienceId String @map("source_experience_id")
 sourceSavepointId String @map("source_savepoint_id")
 initialSavepointId String @map("initial_savepoint_id")
 snapshotHash String @map("snapshot_hash")
 createdAt DateTime @map("created_at")
 @@index([ownerId, rootExperienceId, createdAt, id], map:"ix_experience_forks_root")
 @@index([sourceSavepointId], map:"ix_experience_forks_source")
 @@map("experience_forks")
}
// Explicit inherited prefix. Future scenes of the source grant no access.
model ExperienceSceneRef {
 id String @id
 ownerId String @map("owner_id")
 datasetId String @map("dataset_id")
 experienceId String @map("experience_id")
 savepointId String @map("savepoint_id")
 createdAt DateTime @map("created_at")
 @@unique([experienceId, savepointId], map:"uq_experience_scene_ref")
 @@index([savepointId], map:"ix_scene_refs_savepoint")
 @@map("experience_scene_refs")
}
