{
  "name": "runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "tsx src/main.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "host": "tsx src/host/cli.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.11",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "sharp": "0.35.4",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "exports": {
    "./contracts/generation-media": {
      "types": "./src/contracts/generation-media.ts",
      "default": "./dist/contracts/generation-media.js"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "default": "./dist/host/index.js"
    },
    "./contracts/story-draft": {
      "types": "./src/contracts/story-draft.ts",
      "default": "./dist/contracts/story-draft.js"
    },
    "./contracts/story-draft-validation": {
      "types": "./src/contracts/story-draft-validation.ts",
      "default": "./dist/contracts/story-draft-validation.js"
    },
    "./contracts/character-template": {
      "types": "./src/contracts/character-template.ts",
      "default": "./dist/contracts/character-template.js"
    },
    "./contracts/character-template-validation": {
      "types": "./src/contracts/character-template-validation.ts",
      "default": "./dist/contracts/character-template-validation.js"
    },
    "./contracts/asset": {
      "types": "./src/contracts/asset.ts",
      "default": "./dist/contracts/asset.js"
    },
    "./contracts/asset-validation": {
      "types": "./src/contracts/asset-validation.ts",
      "default": "./dist/contracts/asset-validation.js"
    },
    "./contracts/story-draft-output": {
      "types": "./src/contracts/story-draft-output.ts",
      "default": "./dist/contracts/story-draft-output.js"
    },
    "./contracts/video-deployments": {
      "types": "./src/contracts/video-deployments.ts",
      "default": "./dist/contracts/video-deployments.js"
    },
    "./providers/minimax-request": {
      "types": "./src/providers/minimax-request.ts",
      "default": "./dist/providers/minimax-request.js"
    },
    "./contracts/experience-opening": {
      "types": "./src/contracts/experience-opening.ts",
      "default": "./dist/contracts/experience-opening.js"
    },
    "./contracts/experience-opening-validation": {
      "types": "./src/contracts/experience-opening-validation.ts",
      "default": "./dist/contracts/experience-opening-validation.js"
    },
    "./contracts/experience-opening-output": {
      "types": "./src/contracts/experience-opening-output.ts",
      "default": "./dist/contracts/experience-opening-output.js"
    },
    "./contracts/video-binding-registry": {
      "types": "./src/contracts/video-binding-registry.ts",
      "default": "./dist/contracts/video-binding-registry.js"
    },
    "./contracts/experience-directory": {
      "types": "./src/contracts/experience-directory.ts",
      "default": "./dist/contracts/experience-directory.js"
    },
    "./contracts/generation": {
      "types": "./src/contracts/generation.ts",
      "default": "./dist/contracts/generation.js"
    },
    "./contracts/generation-output": {
      "types": "./src/contracts/generation-output.ts",
      "default": "./dist/contracts/generation-output.js"
    }
  }
}
